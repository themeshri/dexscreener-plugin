{
    "manifest_version": 3,
    "name": "Token Name Monitor 1.0",
    "version": "1.0",
    "description": "Monitors for new token names and plays sound on first appearance",
    "permissions": [
      "storage",
      "notifications"
    ],
    "host_permissions": [
      "*://*.dexscreener.com/*"
    ],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "48": "icon48.png"
      }
    },
    "icons": {
      "48": "icon48.png"
    },
    "content_scripts": [
      {
        "matches": [
          "*://*.dexscreener.com/*"
        ],
        "js": ["content.js"]
      }
    ],
    "background": {
      "service_worker": "background.js"
    },
    "web_accessible_resources": [{
        "resources": ["notification.mp3", "icon48.png"],
        "matches": ["*://*.dexscreener.com/*"]
    }]
  }